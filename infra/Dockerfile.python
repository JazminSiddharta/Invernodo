FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# shared/ viaja completo dentro de cada contenedor (nadie copia las constantes a otro lado)
COPY shared/ /app/shared/
RUN pip install --no-cache-dir -r /app/shared/requirements.txt

# Dependencias extra (solo los workers: TensorFlow). El compose pasa
# EXTRA_REQUIREMENTS=model/requirements.txt; los demás servicios no instalan nada extra.
# Se instalan antes de copiar el resto de model/ para que Docker reutilice esta capa.
ARG EXTRA_REQUIREMENTS=""
COPY model/requirements.txt /app/model/requirements.txt
RUN if [ -n "${EXTRA_REQUIREMENTS}" ]; then pip install --no-cache-dir -r /app/${EXTRA_REQUIREMENTS}; fi

# Paquetes sueltos (arreglo temporal: el worker aún no tiene requirements.txt). Se pasan por EXTRA_PIP desde el compose.
ARG EXTRA_PIP=""
RUN if [ -n "${EXTRA_PIP}" ]; then pip install --no-cache-dir ${EXTRA_PIP}; fi

# model/ (classify vive aquí): el worker lo importa. Los pesos NO van en la imagen, se montan como volumen
COPY model/ /app/model/

# Carpeta del servicio (coordinator, worker, simulator o dashboard), la define el compose
ARG SERVICE
COPY ${SERVICE}/ /app/${SERVICE}/
RUN if [ -f /app/${SERVICE}/requirements.txt ]; then pip install --no-cache-dir -r /app/${SERVICE}/requirements.txt; fi

# Por defecto el servicio se queda vivo sin hacer nada; el compose pone el command real
CMD ["sleep", "infinity"]
